# Секреты клуба — скопировать в C:\ShiftClub\Server\secrets.env (в git НЕ попадает).
# Файл читает Start-ShiftClubApi.ps1 перед запуском API.
#
# Все значения CHANGE_ME обязательно заменить. Сервер при старте предупреждает
# в логе, если что-то осталось со значениями из поставки.

# --- База данных ---
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=shiftclub;Username=shiftclub;Password=CHANGE_ME

# --- Вход в панель ---
# Ключ подписи токенов. Сгенерировать: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__ExpirationMinutes=720

# Владелец, который создаётся при первом запуске пустой базы.
Seed__OwnerLogin=owner
Seed__OwnerPassword=CHANGE_ME_ON_FIRST_BOOT

# Swagger в проданном клубе держим выключенным.
EnableSwagger=false

# --- Лицензия ---
# Enforce=true включает проверку ключа: без действующего ключа не стартуют
# сеансы и не регистрируются новые ПК. PublicKey выдаёт поставщик.
License__Enforce=true
License__PublicKey=CHANGE_ME_VENDOR_PUBLIC_KEY

# --- Копии базы ---
Backup__Enabled=true
Backup__DailyHourLocal=6
Backup__KeepDays=14
# Если pg_dump не в PATH, указать путь явно:
# Backup__PgDumpPath=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe

# Миграции применяются при старте. На всякий случай перед ними делается копия базы,
# и без удачной копии миграции не запускаются. Можно вообще запретить автоприменение:
# Database__AutoMigrate=false

# --- Безопасность ---
# Домены, с которых разрешено обращаться к API. Локальная сеть (192.168.x.x и т.п.)
# разрешена всегда, её перечислять не нужно. Звёздочка = пускать кого угодно.
# Cors__AllowedOrigins__0=https://panel.myclub.kz
# Security__RequireHttps=true
# Включать только если перед сервером стоит свой nginx/Cloudflare:
# Security__TrustForwardedHeaders=true
Security__LoginAttemptsPerMinute=10

# --- Панель найма (персональные данные кандидатов) ---
Hiring__ManagerPin=CHANGE_ME_6_DIGITS
Hiring__SessionHours=12

# --- Telegram ---
# Свой бот от @BotFather. Чужой/боевой токен в тестовый сервер не вставлять.
# Telegram__BotToken=CHANGE_ME

# --- Kaspi Smart POS (локальная сеть) ---
# TerminalId берётся из «Kaspi Гид → О терминале» конкретного клуба.
# KaspiPos__TerminalId=CHANGE_ME
# KaspiPos__RegisterName=CHANGE_ME
# KaspiPos__Host=192.168.1.XXX
