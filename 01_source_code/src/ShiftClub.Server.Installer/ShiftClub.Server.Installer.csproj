<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ShiftClub.Server.Setup</AssemblyName>
    <RootNamespace>ShiftClub.Server.Installer</RootNamespace>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>Сервер клуба</Product>
    <Company>Клуб</Company>
    <Description>Установщик сервера клуба</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShiftClub.Server.Setup\ShiftClub.Server.Setup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload\server.zip" Condition="Exists('payload\server.zip')" LogicalName="payload.server.zip" />
    <EmbeddedResource Include="payload\postgres.zip" Condition="Exists('payload\postgres.zip')" LogicalName="payload.postgres.zip" />
    <EmbeddedResource Include="payload\vc_redist.x64.exe" Condition="Exists('payload\vc_redist.x64.exe')" LogicalName="payload.vc_redist.x64.exe" />
    <EmbeddedResource Include="..\..\scripts\Start-ShiftClubApi.ps1" LogicalName="script.Start-ShiftClubApi.ps1" />
    <EmbeddedResource Include="..\..\scripts\Watch-ShiftClubApi.ps1" LogicalName="script.Watch-ShiftClubApi.ps1" />
  </ItemGroup>

</Project>
