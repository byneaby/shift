{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=shiftclub;Username=shiftclub;Password=CHANGE_ME"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ClientUpdates": {
    "Enabled": true,
    "PackagesPath": "data/client-updates"
  },
  "Database": {
    "AutoMigrate": true,
    "BackupBeforeMigrate": true
  },
  "Backup": {
    "Enabled": true,
    "Directory": "data/backups",
    "KeepDays": 14,
    "DailyHourLocal": 6,
    "PgDumpPath": "",
    "TimeoutMinutes": 30
  },
  "License": {
    "Enforce": false,
    "PublicKey": ""
  },
  "AllowedHosts": "*"
}
