# Club production secrets — copy to C:\ShiftClub\Server\secrets.env (NOT in git).
# Loaded by Start-ShiftClubApi.ps1 before launching the API.

ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=shiftclub;Username=shiftclub;Password=CHANGE_ME
Jwt__SigningKey=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__ExpirationMinutes=720
Seed__OwnerLogin=owner
Seed__OwnerPassword=CHANGE_ME_ON_FIRST_BOOT
EnableSwagger=false
Hiring__ManagerPin=2580
Hiring__SessionHours=12

# Kaspi Smart POS (LAN). Host — статический IP терминала из «Kaspi Гид → О терминале».
KaspiPos__TerminalId=32555483
KaspiPos__RegisterName=ShiftClub
# KaspiPos__Host=192.168.1.XXX
