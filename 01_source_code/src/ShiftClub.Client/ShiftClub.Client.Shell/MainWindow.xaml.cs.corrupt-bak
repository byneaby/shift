    /// <summary>User opened Â«ÐšÑƒÐ¿Ð¸Ñ‚ÑŒ Ð½Ð¾Ð²Ñ‹Ð¹ ÑÐµÐ°Ð½ÑÂ» â€” don't hide tariff panel on UI refresh.</summary>
    private bool _showBuySessionExplicit;
