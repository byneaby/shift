                                        },
                                        new TextBlock
                                        {
                                            Text = p.IsAvailable
                                                ? (_agent.Session is null ? "ÐÑƒÐ¶ÐµÐ½ ÑÐµÐ°Ð½Ñ" : p.CategoryName)
