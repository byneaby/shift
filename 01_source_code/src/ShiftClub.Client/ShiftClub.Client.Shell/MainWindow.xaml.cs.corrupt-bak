        {
            _showBuySessionExplicit = false;
            HomeTimeBankChoice.Visibility = Visibility.Collapsed;
            HomeBuySessionPanel.Visibility = Visibility.Visible;
            return;
        }

        var zoneMins = _agent.Customer.CurrentZoneTimeBankMinutes;
        var zoneName = _agent.Customer.CurrentZoneName ?? "ÑÑ‚Ð¾Ð¹ Ð·Ð¾Ð½Ñ‹";
        if (zoneMins > 0)
        {
            HomeTimeBankChoice.Visibility = Visibility.Visible;
            HomeTimeBankTitle.Text = $"Ð‘Ð°Ð½Ðº Ð²Ñ€ÐµÐ¼ÐµÐ½Ð¸ Â· {zoneName}: {zoneMins} Ð¼Ð¸Ð½";
            HomeTimeBankHint.Text =
                $"ÐœÐ¾Ð¶Ð½Ð¾ Ð·Ð°Ð¿ÑƒÑÑ‚Ð¸Ñ‚ÑŒ ÑÐµÐ°Ð½Ñ Ð¸Ð· Ð±Ð°Ð½ÐºÐ° {zoneName}. ÐœÐ¸Ð½ÑƒÑ‚Ñ‹ Ð´Ñ€ÑƒÐ³Ð¸Ñ… Ð·Ð¾Ð½ Ð½Ð° ÑÑ‚Ð¾Ð¼ ÐŸÐš Ð½ÐµÐ´Ð¾ÑÑ‚ÑƒÐ¿Ð½Ñ‹.";
            TimeBankRingText.Text = zoneMins.ToString();
            // ÐŸÐ¾ÐºÐ° Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÑŒ Ð½Ðµ Ð½Ð°Ð¶Ð°Ð» Â«ÐšÑƒÐ¿Ð¸Ñ‚ÑŒ Ð½Ð¾Ð²Ñ‹Ð¹ ÑÐµÐ°Ð½ÑÂ», Ð¿Ñ€ÑÑ‡ÐµÐ¼ Ñ‚Ð°Ñ€Ð¸Ñ„Ñ‹ â€” Ð¸Ð½Ð°Ñ‡Ðµ Ñ‚Ð¸Ðº UI Ð¸Ñ… Ð·Ð°ÐºÑ€Ñ‹Ð²Ð°ÐµÑ‚.
            HomeBuySessionPanel.Visibility = _showBuySessionExplicit
                ? Visibility.Visible
                : Visibility.Collapsed;
            StartFromBankButton.Content = $"Ð˜Ð“Ð ÐÐ¢Ð¬ Ð¡ Ð‘ÐÐÐšÐ Â· {zoneMins} ÐœÐ˜Ð";
        }
        else
        {
            HomeTimeBankChoice.Visibility = Visibility.Collapsed;
            HomeBuySessionPanel.Visibility = Visibility.Visible;
        }
    }

    private void ShowBuySession_Click(object sender, RoutedEventArgs e)
