            {
                Text = "Ð¢Ð¾Ð²Ð°Ñ€Ð¾Ð² Ð¿Ð¾ÐºÐ° Ð½ÐµÑ‚. Ð”Ð¾Ð±Ð°Ð²ÑŒÑ‚Ðµ Ð¸Ñ… Ð² Ð¿Ð°Ð½ÐµÐ»Ð¸: Ð‘Ð°Ñ€ â†’ Ð¢Ð¾Ð²Ð°Ñ€Ñ‹.",
                Foreground = (Brush)FindResource("Muted"),
                Margin = new Thickness(8)
            });
        }

        RefreshCartUi();
    }

    private void AddToCart(ClientBarProductDto product)
    {
        if (_agent.Session is null)
        {
            _ = ShowInfoAsync("ÐœÐ°Ð³Ð°Ð·Ð¸Ð½", "Ð—Ð°ÐºÐ°Ð· Ð´Ð¾ÑÑ‚ÑƒÐ¿ÐµÐ½ Ð²Ð¾ Ð²Ñ€ÐµÐ¼Ñ ÑÐµÐ°Ð½ÑÐ°");
            return;
        }

        if (!product.IsAvailable)
            return;

        if (_cart.TryGetValue(product.Id, out var existing))
            _cart[product.Id] = (product, existing.Qty + 1);
        else
            _cart[product.Id] = (product, 1);

        ShopFlash.Text = $"Ð’ ÐºÐ¾Ñ€Ð·Ð¸Ð½Ðµ: {product.Name}";
        RefreshCartUi();
    }

    private void ChangeCartQty(Guid productId, decimal delta)
    {
        if (!_cart.TryGetValue(productId, out var line))
            return;
        var next = line.Qty + delta;
        if (next <= 0)
            _cart.Remove(productId);
        else
            _cart[productId] = (line.Product, next);
        RefreshCartUi();
    }

    private void ClearCart_Click(object sender, RoutedEventArgs e)
    {
        _cart.Clear();
        ShopFlash.Text = "";
        RefreshCartUi();
    }

    private void RefreshCartUi()
    {
        ShopCartLines.Children.Clear();
        var totalQty = _cart.Values.Sum(x => x.Qty);
        var totalSum = _cart.Values.Sum(x => x.Product.SalePrice * x.Qty);

        if (_cart.Count == 0)
        {
            ShopCartSummary.Text = "ÐšÐ¾Ñ€Ð·Ð¸Ð½Ð° Ð¿ÑƒÑÑ‚Ð°";
            ShopCartHint.Text = "Ð”Ð¾Ð±Ð°Ð²ÑŒÑ‚Ðµ Ñ‚Ð¾Ð²Ð°Ñ€Ñ‹ Ð¸ Ð¾Ñ„Ð¾Ñ€Ð¼Ð¸Ñ‚Ðµ Ð¾Ð´Ð½Ð¸Ð¼ Ð·Ð°ÐºÐ°Ð·Ð¾Ð¼";
            CheckoutCartButton.IsEnabled = false;
            return;
        }

        ShopCartSummary.Text = $"ÐšÐ¾Ñ€Ð·Ð¸Ð½Ð°: {totalQty:0} ÑˆÑ‚ Â· {totalSum:0} â‚¸";
        ShopCartHint.Text = "ÐŸÑ€Ð¾Ð²ÐµÑ€ÑŒÑ‚Ðµ Ð¿Ð¾Ð·Ð¸Ñ†Ð¸Ð¸ Ð¸ Ð½Ð°Ð¶Ð¼Ð¸Ñ‚Ðµ Â«ÐžÑ„Ð¾Ñ€Ð¼Ð¸Ñ‚ÑŒ Ð·Ð°ÐºÐ°Ð·Â»";
        CheckoutCartButton.IsEnabled = _agent.Session is not null;

        foreach (var (id, line) in _cart.OrderBy(x => x.Value.Product.Name))
        {
            var row = new DockPanel { Margin = new Thickness(0, 0, 0, 6) };
            var minus = new Button
            {
                Content = "âˆ’",
                Width = 36,
                Style = (Style)FindResource("GhostButton"),
                Tag = id
            };
            minus.Click += (_, _) => ChangeCartQty(id, -1);
            var plus = new Button
            {
                Content = "+",
                Width = 36,
                Style = (Style)FindResource("GhostButton"),
                Tag = id,
                Margin = new Thickness(6, 0, 0, 0)
            };
            plus.Click += (_, _) => ChangeCartQty(id, 1);
            var controls = new StackPanel { Orientation = Orientation.Horizontal };
            controls.Children.Add(minus);
            controls.Children.Add(plus);
            DockPanel.SetDock(controls, Dock.Right);
            row.Children.Add(controls);
            row.Children.Add(new TextBlock
            {
                Text = $"{line.Product.Name} Ã— {line.Qty:0} Â· {line.Product.SalePrice * line.Qty:0} â‚¸",
                VerticalAlignment = VerticalAlignment.Center,
                TextWrapping = TextWrapping.Wrap
            });
            ShopCartLines.Children.Add(row);
        }
    }

    private async void CheckoutCart_Click(object sender, RoutedEventArgs e)
    {
        try
        {
            if (_agent.Session is null)
                throw new InvalidOperationException("Ð—Ð°ÐºÐ°Ð· Ð´Ð¾ÑÑ‚ÑƒÐ¿ÐµÐ½ Ð²Ð¾ Ð²Ñ€ÐµÐ¼Ñ ÑÐµÐ°Ð½ÑÐ°");
            if (_cart.Count == 0)
                throw new InvalidOperationException("ÐšÐ¾Ñ€Ð·Ð¸Ð½Ð° Ð¿ÑƒÑÑ‚Ð°");

            var mode = "PayAtCashier";
            if (!IsCashDeskManagedSession() && _agent.Customer is not null
                && ShopPayCombo.SelectedItem is ComboBoxItem { Tag: string tag })
                mode = tag;

            var lines = _cart.Values
                .Select(x => new ClientPlaceBarOrderItemRequest(x.Product.Id, x.Qty))
                .ToList();
            var total = _cart.Values.Sum(x => x.Product.SalePrice * x.Qty);
            var preview = string.Join("\n", _cart.Values.Select(x => $"â€¢ {x.Product.Name} Ã— {x.Qty:0}"));
            if (!await ShowConfirmAsync(
                    "ÐžÑ„Ð¾Ñ€Ð¼Ð¸Ñ‚ÑŒ Ð·Ð°ÐºÐ°Ð·?",
                    $"{preview}\n\nÐ˜Ñ‚Ð¾Ð³Ð¾: {total:0} â‚¸"))
                return;

            await _agent.PlaceBarOrderAsync(lines, mode);
            _cart.Clear();
            ShopFlash.Text = _agent.LastOrderFlash ?? "Ð—Ð°ÐºÐ°Ð· Ð¾Ñ‚Ð¿Ñ€Ð°Ð²Ð»ÐµÐ½";
            RenderShop();
            BindProfile();
        }
        catch (Exception ex)
        {
            await ShowInfoAsync("ÐœÐ°Ð³Ð°Ð·Ð¸Ð½", ex.Message);
        }
    }

    private async Task OrderProduct(ClientBarProductDto product)
    {
        AddToCart(product);
        await Task.CompletedTask;
    }

    private Uri? ResolveProductImageUri(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return null;
        if (Uri.TryCreate(imageUrl, UriKind.Absolute, out var abs))
            return abs;
        if (Uri.TryCreate($"{_serverUrl}{imageUrl}", UriKind.Absolute, out var rel))
            return rel;
        return null;
    }

    private void BuildShopCategories()
    {
        ShopCategoryPanel.Children.Clear();
        void AddCat(string label, string id)
        {
            var selected = _shopCategoryId == id;
            var btn = new Button
            {
                Content = label,
                Style = (Style)FindResource(selected ? "PillButtonActive" : "PillButton"),
                Tag = id
            };
            btn.Click += (_, _) =>
            {
                _shopCategoryId = id;
                RenderShop();
            };
            ShopCategoryPanel.Children.Add(btn);
        }

        AddCat("Ð’ÑÐµ Ñ‚Ð¾Ð²Ð°Ñ€Ñ‹", "");
        foreach (var c in _agent.BarCategories)
            AddCat(c.Name, c.Id.ToString());
    }

    private void Search_Changed(object sender, TextChangedEventArgs e)
