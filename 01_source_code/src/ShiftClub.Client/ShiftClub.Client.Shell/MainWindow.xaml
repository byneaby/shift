<Window x:Class="ShiftClub.Client.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клуб"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Background="#0E0E10"
        FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        Deactivated="Window_Deactivated">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A120C" Offset="0"/>
        <GradientStop Color="#121214" Offset="0.35"/>
        <GradientStop Color="#0E0E10" Offset="0.7"/>
        <GradientStop Color="#14100E" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <!-- Soft ambient glow -->
    <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Margin="-280,0,0,-220" IsHitTestVisible="False" Opacity="0.55">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#55FF6A00" Offset="0"/>
          <GradientStop Color="#00FF6A00" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="700" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-180,-200,0" IsHitTestVisible="False" Opacity="0.25">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#33FF8A2B" Offset="0"/>
          <GradientStop Color="#00FF8A2B" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- WAITING REGISTRATION -->
    <Grid x:Name="PanelWaiting" Visibility="Collapsed" ClipToBounds="True">
      <TextBlock x:Name="WaitingPcName" Text="01" FontSize="340" FontWeight="Black" FontStyle="Italic"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,0,0,0"
                 IsHitTestVisible="False" Panel.ZIndex="0">
        <TextBlock.Foreground>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFF9A4A" Offset="0"/>
            <GradientStop Color="#FFFF6A00" Offset="0.45"/>
            <GradientStop Color="#FFB84300" Offset="1"/>
          </LinearGradientBrush>
        </TextBlock.Foreground>
        <TextBlock.Effect>
          <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.75" Color="#FF6A00"/>
        </TextBlock.Effect>
      </TextBlock>
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"
              Style="{StaticResource DialogShell}" Padding="56" MinWidth="420">
        <StackPanel>
          <TextBlock x:Name="RegBrandMark" Text="Клуб" FontSize="18" FontStyle="Italic" FontWeight="Bold"
                     Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
          <TextBlock Text="Ожидание подтверждения" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock x:Name="RegCodeText" Text="—" FontSize="28" FontWeight="Bold"
                     Foreground="{StaticResource Accent}" HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,18,0,0"/>
          <TextBlock Text="Подтвердите этот ПК на карте зала" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="WaitingVersionLabel" Panel.ZIndex="2"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,20,20,72"
                 FontSize="12" Foreground="#666"/>
    </Grid>

    <!-- LOGIN: neon PC number LEFT, glass card CENTER -->
    <Grid x:Name="PanelLogin" Visibility="Visible" ClipToBounds="True" PreviewKeyDown="PanelLogin_PreviewKeyDown">
      <Image x:Name="LoginBackgroundImage" Stretch="UniformToFill" IsHitTestVisible="False"
             Opacity="0" Visibility="Collapsed"/>
      <!-- Fallback / dim overlay -->
      <Rectangle x:Name="LoginFallbackBg" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.25,0.55" GradientOrigin="0.2,0.5" RadiusX="0.7" RadiusY="0.85">
            <GradientStop Color="#3A2218" Offset="0"/>
            <GradientStop Color="#141210" Offset="0.45"/>
            <GradientStop Color="#0A0A0C" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle IsHitTestVisible="False" Opacity="0.45">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.2">
            <GradientStop Color="#66000000" Offset="0"/>
            <GradientStop Color="#44000000" Offset="0.5"/>
            <GradientStop Color="#88000000" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <TextBlock x:Name="LoginPcNameBackdrop" Text="01" FontSize="320" FontWeight="Black" FontStyle="Italic"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0"
                 IsHitTestVisible="False" Panel.ZIndex="0" Opacity="0.22">
        <TextBlock.Foreground>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00FF8A2B" Offset="0"/>
            <GradientStop Color="#AAFF6A00" Offset="0.4"/>
            <GradientStop Color="#FFFF6A00" Offset="1"/>
          </LinearGradientBrush>
        </TextBlock.Foreground>
      </TextBlock>

      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="920" MaxWidth="920"
              MaxHeight="900" Panel.ZIndex="1" Style="{StaticResource DialogShell}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="340"/>
          </Grid.ColumnDefinitions>

          <!-- LEFT: credentials -->
          <StackPanel Grid.Column="0" Margin="36,32,28,32">
            <DockPanel Margin="0,0,0,6">
              <TextBlock x:Name="LoginBrandMark" Text="Клуб" FontSize="14" FontWeight="Bold" FontStyle="Italic"
                         Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
              <TextBlock x:Name="LoginPcName" DockPanel.Dock="Right" Text="ПК 01"
                         FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                         VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Вход в аккаунт" FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock Text="Телефон и ПИН с кассы — или справа через Telegram (можно создать аккаунт)."
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <TextBlock x:Name="LoginBookingHold" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                       Margin="0,16,0,0" Visibility="Collapsed"/>

            <TextBlock Text="Телефон или логин" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,22,0,8"/>
            <TextBox x:Name="LoginBox" FontSize="16" Padding="16,14"/>

            <TextBlock Text="ПИН или пароль" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,8"/>
            <Grid>
              <PasswordBox x:Name="PinBox" FontSize="16" Padding="16,14,48,14"/>
              <TextBox x:Name="PinBoxClear" FontSize="16" Padding="16,14,48,14" Visibility="Collapsed"
                       Background="{StaticResource InputBg}"/>
              <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="40"
                      Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Click="TogglePinVisibility_Click" ToolTip="Показать / скрыть">
                <TextBlock x:Name="PinEyeIcon" FontFamily="{StaticResource IconFont}" Text="&#xE7B3;"
                           FontSize="16" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
              </Button>
            </Grid>

            <TextBlock x:Name="LoginError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,8"/>
            <Button x:Name="LoginButton" Content="Войти" Style="{StaticResource AccentButton}"
                    Click="Login_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch" Padding="20,16"/>

            <Button Style="{StaticResource GhostButton}" Margin="0,12,0,0" Click="CallAdmin_Click"
                    HorizontalAlignment="Stretch" BorderBrush="#55FF6A00">
              <TextBlock Text="Вызвать администратора" HorizontalAlignment="Center"/>
            </Button>

            <Button x:Name="LoginBackToPostSession" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                    Click="LoginBackToPostSession_Click" HorizontalAlignment="Stretch"
                    BorderBrush="#88FF6A00" Visibility="Collapsed"
                    Content="← К таймеру перезагрузки"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
              <Button Width="48" Height="48" Margin="0,0,12,0" Cursor="Hand"
                      ToolTip="Перезагрузить ПК" Click="LoginRestart_Click"
                      Background="#1C1C1F" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="24" Width="48" Height="48">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#88FF6A00"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE777;" FontSize="17"
                           Foreground="{StaticResource Accent2}"/>
              </Button>
              <Button Width="48" Height="48" Cursor="Hand"
                      ToolTip="Выключить ПК" Click="LoginShutdown_Click"
                      Background="#1C1C1F" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="24" Width="48" Height="48">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#88FF6A00"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7E8;" FontSize="17"
                           Foreground="{StaticResource Accent2}"/>
              </Button>
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="1" Width="1" Background="#22FFFFFF" Margin="0,28"/>

          <!-- RIGHT: Telegram / mobile app -->
          <StackPanel Grid.Column="2" Margin="28,32,36,32">
            <TextBlock x:Name="TgColumnTitle" Text="Вход через Telegram" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="TgColumnSub" Text="Сканируйте QR в приложении клуба. Если аккаунта нет — создадите его на телефоне или здесь, вход на этот ПК будет сразу."
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <Border x:Name="TgQrFrame" Background="#0A0A0C" CornerRadius="16" Padding="16" Margin="0,20,0,0"
                    BorderBrush="#33FF6A00" BorderThickness="1" HorizontalAlignment="Center"
                    Width="232" Height="232">
              <Grid>
                <Image x:Name="TgQrImage" Width="200" Height="200"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Border x:Name="TgQrExpiredOverlay" Visibility="Collapsed" Background="#E00A0A0C" CornerRadius="12">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                    <TextBlock Text="Код устарел" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Нажмите, чтобы получить новый QR"
                               Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,8,0,14" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Content="Обновить QR" Style="{StaticResource AccentButton}"
                            Click="TelegramLogin_Click" Padding="18,12" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <StackPanel x:Name="TgQrPanel" Visibility="Visible" Margin="0,14,0,0">
              <TextBlock x:Name="TgQrHint" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{StaticResource Muted}" FontSize="12"/>
              <Button x:Name="TelegramLoginButton" Content="Новый QR" Style="{StaticResource GhostButton}"
                      Click="TelegramLogin_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="16,10"
                      BorderBrush="#55FF6A00" ToolTip="Если QR плохо читается или вы передумали"/>
            </StackPanel>

            <!-- Регистрация на ПК после скана TG без аккаунта -->
            <Border x:Name="TgRegisterPanel" Visibility="Collapsed" Background="#14FF6A00"
                    CornerRadius="14" Padding="16" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Telegram подтверждён" FontWeight="Bold" FontSize="16"/>
                <TextBlock x:Name="TgRegisterHint" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource Muted}" Margin="0,6,0,12"
                           Text="Заполните данные здесь — войдёте сразу. Либо продолжите в телефоне: после сохранения ПК тоже войдёт сам."/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Имя" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TgRegFirst" Padding="12,10" FontSize="14"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Фамилия" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TgRegLast" Padding="12,10" FontSize="14"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Телефон" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="TgRegPhone" Margin="0,0,0,8" Padding="12,10" FontSize="14"
                         ToolTip="Как на кассе, например 87001234567"/>
                <TextBlock Text="Пароль (минимум 4 символа)" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TgRegPass" Margin="0,0,0,8" Padding="12,10" FontSize="14"/>
                <CheckBox x:Name="TgRegLinkExisting" Content="Уже есть аккаунт — привязать этот Telegram"
                          Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                          Checked="TgRegLinkExisting_Changed" Unchecked="TgRegLinkExisting_Changed"/>
                <TextBlock x:Name="TgRegError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button x:Name="TgRegSubmitButton" Content="Создать и войти" Style="{StaticResource AccentButton}"
                        Click="TgRegisterComplete_Click" Padding="16,12" HorizontalAlignment="Stretch"/>
                <Button Content="Отмена — новый QR" Style="{StaticResource GhostButton}"
                        Click="TgRegisterCancel_Click" Margin="0,8,0,0" Padding="16,10"
                        HorizontalAlignment="Stretch" BorderBrush="#55FFFFFF"/>
              </StackPanel>
            </Border>

            <Border x:Name="TgHowToPanel" Background="#14FF6A00" CornerRadius="12" Padding="14" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="Как войти" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="TgHowToText" Text="1) Бот клуба → «Открыть».&#x0a;2) Сканируйте QR.&#x0a;3) Нет аккаунта? Создайте в телефоне или справа на ПК — вход автоматический."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        </ScrollViewer>
      </Border>

      <TextBlock x:Name="LoginVersionLabel" Panel.ZIndex="2"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,24,24,24"
                 FontSize="12" Foreground="#666"/>
    </Grid>

    <!-- После сеанса: таймер до перезагрузки + докупка времени -->
    <Grid x:Name="PanelPostSession" Visibility="Collapsed" Panel.ZIndex="45" Background="#F00A0A0C">
      <Border Style="{StaticResource DialogShell}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="36" Width="720" MaxWidth="720" MaxHeight="920">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="PostSessionBrandMark" Text="Клуб" FontSize="14" FontWeight="Bold" FontStyle="Italic"
                       Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
            <TextBlock Text="Сеанс завершён" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="PostSessionPcLabel" Text="ПК" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="14"/>

            <Border Background="#22FF6A00" CornerRadius="16" Padding="20,16" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="Перезагрузка через" Foreground="{StaticResource Muted}"
                           FontSize="13" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PostSessionCountdown" Text="7:00" FontSize="48" FontWeight="Black"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"
                           FontFamily="Consolas" Margin="0,4,0,0"/>
                <TextBlock Text="Чтобы продолжить играть — добавьте время до перезагрузки."
                           Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Сколько времени" FontWeight="SemiBold" FontSize="15" Margin="0,24,0,10"/>
            <WrapPanel x:Name="PostSessionTimePanel">
              <Button Content="+15 мин" Tag="15" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionTime_Click" BorderBrush="#55FF6A00"/>
              <Button Content="+30 мин" Tag="30" Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionTime_Click"/>
              <Button Content="+1 час" Tag="60" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionTime_Click" BorderBrush="#55FF6A00"/>
              <Button Content="+2 часа" Tag="120" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionTime_Click" BorderBrush="#55FF6A00"/>
            </WrapPanel>

            <TextBlock Text="Как оплатить" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,10"/>
            <WrapPanel x:Name="PostSessionPayPanel">
              <Button Content="Наличные" Tag="Cash" Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionPay_Click"/>
              <Button Content="Kaspi QR" Tag="KaspiQr" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionPay_Click" BorderBrush="#55FF6A00"/>
              <Button Content="Баланс" Tag="Balance" Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                      Padding="16,12" Click="PostSessionPay_Click" BorderBrush="#55FF6A00"/>
            </WrapPanel>

            <Border Background="#14FFFFFF" CornerRadius="12" Padding="16" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="Что сделать" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="PostSessionHint" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource Muted}" Margin="0,8,0,0"
                           Text="Подойдите к администратору с номером этого ПК. Скажите «+30 мин» и оплатите наличными."/>
              </StackPanel>
            </Border>

            <Button x:Name="PostSessionContinueBalanceButton" Content="Продолжить с баланса"
                    Style="{StaticResource AccentButton}" Margin="0,20,0,0" Padding="20,16"
                    HorizontalAlignment="Stretch" Click="PostSessionContinueBalance_Click"
                    Visibility="Collapsed"/>
            <Button x:Name="PostSessionContinueTimeBankButton" Content="Продолжить с банка времени"
                    Style="{StaticResource AccentButton}" Margin="0,10,0,0" Padding="20,16"
                    HorizontalAlignment="Stretch" Click="PostSessionContinueTimeBank_Click"
                    Visibility="Collapsed"/>
            <Button x:Name="PostSessionCallAdminButton" Content="Вызвать администратора"
                    Style="{StaticResource AccentButton}" Margin="0,10,0,0" Padding="20,16"
                    HorizontalAlignment="Stretch" Click="PostSessionCallAdmin_Click"/>
            <Button x:Name="PostSessionShowLoginButton" Content="Показать вход в аккаунт" Style="{StaticResource GhostButton}"
                    Margin="0,10,0,0" Padding="16,12" HorizontalAlignment="Stretch"
                    BorderBrush="#55FFFFFF" Click="PostSessionShowLogin_Click"
                    ToolTip="Если платите с баланса — войдите по телефону и ПИН"/>
            <TextBlock x:Name="PostSessionFlash" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,12,0,0" FontSize="13" Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ADMIN MODE (CCBoot superclient / image setup) -->
    <Grid x:Name="PanelAdminMode" Visibility="Collapsed" Panel.ZIndex="50" Background="#E00B0B0C">
      <Border Style="{StaticResource DialogShell}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="40" MinWidth="440" MaxWidth="520">
        <StackPanel>
          <TextBlock Text="Админ-режим" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="Как Senet/iCafe: киоск и защита Shell отключены. Keeper и служба не поднимают оболочку, пока активен admin.mode. Можно настраивать образ CCBoot."
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                     Margin="0,14,0,0" FontSize="13"/>
          <Button Content="Свернуть Shell и работать с рабочим столом" Style="{StaticResource AccentButton}"
                  Margin="0,24,0,0" Click="AdminMinimize_Click"/>
          <Button Content="Закрыть Shell (остаться в админ-режиме)" Style="{StaticResource GhostButton}"
                  Margin="0,10,0,0" Click="AdminCloseShell_Click"/>
          <Button Content="Выйти из админ-режима" Style="{StaticResource GhostButton}"
                  Margin="0,10,0,0" Click="AdminExitMode_Click"/>
          <TextBlock Text="После «Закрыть Shell»: перезагрузка ПК снимет admin.mode (writeback) и вернёт Shell."
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                     Margin="0,14,0,0" FontSize="11"/>
          <TextBlock x:Name="AdminModeError" Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                     Margin="0,12,0,0" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ADMIN PASSWORD DIALOG -->
    <Grid x:Name="PanelAdminLogin" Visibility="Collapsed" Panel.ZIndex="60" Background="#CC000000">
      <Border Style="{StaticResource DialogShell}" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="32" MinWidth="360">
        <StackPanel>
          <TextBlock Text="Пароль админ-режима" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="Задаётся владельцем в панели → Сотрудники" Foreground="{StaticResource Muted}"
                     FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                     TextAlignment="Center"/>
          <PasswordBox x:Name="AdminPasswordBox" FontSize="16" Margin="0,18,0,0"/>
          <TextBlock x:Name="AdminLoginError" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource GhostButton}" Padding="16,10" Margin="0,0,8,0"
                    Click="AdminLoginCancel_Click"/>
            <Button Content="Войти" Style="{StaticResource AccentButton}" Padding="20,10"
                    Click="AdminLoginOk_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- MAIN SHELL -->
    <!-- Bottom margin clears Windows taskbar (Shell uses WorkArea); keep modest padding -->
    <Grid x:Name="PanelShell" Visibility="Collapsed" Margin="16,16,16,16" ClipToBounds="False">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="108" MinWidth="100"/>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="292" MinWidth="250" MaxWidth="340"/>
      </Grid.ColumnDefinitions>

      <!-- Left nav — icon + text labels -->
      <Border Grid.Column="0" Background="#F0141416" CornerRadius="20" Margin="0,0,14,0" Padding="8,16"
              BorderBrush="{StaticResource Stroke}" BorderThickness="1" ClipToBounds="False">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28" Direction="270" Color="#000000"/>
        </Border.Effect>
        <DockPanel>
          <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="12" Margin="0,0,0,18"
                  HorizontalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF8A2B" Offset="0"/>
                <GradientStop Color="#FF6A00" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="S" FontSize="18" FontWeight="Black" FontStyle="Italic"
                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="LogoutButton" Style="{StaticResource NavButton}" Click="Logout_Click"
                    ToolTip="Выйти из аккаунта" HorizontalAlignment="Stretch" MinHeight="64" Padding="4,8">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="&#xEDE1;" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Выйти" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="VersionLabel" FontSize="9" Foreground="#555" HorizontalAlignment="Center"
                       Margin="0,8,0,2" TextAlignment="Center"/>
          </StackPanel>
          <StackPanel VerticalAlignment="Top">
            <Button x:Name="NavHome" Style="{StaticResource NavButtonActive}" Click="Nav_Click" Tag="home"
                    ToolTip="Главная" HorizontalAlignment="Stretch" MinHeight="64" Padding="4,8">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" HorizontalAlignment="Center"/>
                <TextBlock Text="Главная" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavGames" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="games"
                    ToolTip="Игры" HorizontalAlignment="Stretch" MinHeight="64" Padding="4,8">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7FC;" HorizontalAlignment="Center"/>
                <TextBlock Text="Игры" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavShop" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="shop"
                    ToolTip="Бар" HorizontalAlignment="Stretch" MinHeight="64" Padding="4,8">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE719;" HorizontalAlignment="Center"/>
                <TextBlock Text="Бар" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavAccount" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="account"
                    ToolTip="Аккаунт" HorizontalAlignment="Stretch" MinHeight="64" Padding="4,8">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;" HorizontalAlignment="Center"/>
                <TextBlock Text="Аккаунт" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="NavHelp" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="help"
                    ToolTip="Помощь" HorizontalAlignment="Stretch" MinHeight="64" Padding="4,8">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE897;" HorizontalAlignment="Center"/>
                <TextBlock Text="Помощь" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Center -->
      <Grid Grid.Column="1" Margin="0,0,12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource StatusChip}" MaxWidth="240">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F8;" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="SessionPcText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Border x:Name="OnlineBadge" Style="{StaticResource StatusChip}" Background="#14241A"
                    BorderBrush="#553DDC97" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="OnlineDot" Width="8" Height="8" Fill="#3DDC97" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="OnlineText" Text="Онлайн" FontSize="13" FontWeight="SemiBold" Foreground="#3DDC97" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusChip}">
              <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="RemainingChip" Style="{StaticResource StatusChip}" Margin="0"
                    BorderBrush="#55FF6A00" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="RemainingText" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Accent2}" VerticalAlignment="Center"/>
                <Button x:Name="HeaderExtendButton" Content="Продлить" Style="{StaticResource AccentButton}"
                        Padding="10,6" Margin="10,0,0,0" Click="ExtendMenu_Click" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Cursor="Hand" MouseLeftButtonUp="ProfileHeader_Click" ToolTip="Мой аккаунт">
            <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF8A2B" Offset="0"/>
                  <GradientStop Color="#FF6A00" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#FF6A00"/>
              </Border.Effect>
              <TextBlock x:Name="AvatarLetter" Text="?" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
            </Border>
            <StackPanel VerticalAlignment="Center" MaxWidth="180">
              <TextBlock x:Name="ProfileName" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ProfileLoyalty" FontSize="12" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </StackPanel>
        </DockPanel>

        <!-- Content tabs -->
        <Grid Grid.Row="1">
          <!-- HOME -->
          <Border x:Name="TabHome" Background="Transparent" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
              <StackPanel>
                <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
                <TextBlock x:Name="HomeHello" FontSize="36" FontWeight="Bold"/>
                <TextBlock x:Name="HomeSub" Foreground="{StaticResource Muted}" Margin="0,10,0,28" TextWrapping="Wrap" FontSize="15"/>

                <StackPanel x:Name="HomeAccountStartPanel">
                  <!-- Time bank hero -->
                  <Border x:Name="HomeTimeBankChoice" Visibility="Collapsed" CornerRadius="18" Margin="0,0,0,16"
                          BorderBrush="#33FF6A00" BorderThickness="1" ClipToBounds="True" MinHeight="210">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A1208" Offset="0"/>
                        <GradientStop Color="#1A0C08" Offset="0.45"/>
                        <GradientStop Color="#0E0E10" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="22">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="HomeTimeBankTitle" FontSize="20" FontWeight="Bold" Text="Банк времени этой зоны"/>
                        <TextBlock x:Name="HomeTimeBankHint" Foreground="#B0B0B0" Margin="0,10,0,0" TextWrapping="Wrap"
                                   FontSize="13"
                                   Text="Минуты сэкономлены в этой зоне — их нельзя перенести на другую зону."/>
                      </StackPanel>
                      <Grid Grid.Column="1" Width="110" Height="110" VerticalAlignment="Center">
                        <Ellipse Stroke="#33FFFFFF" StrokeThickness="8"/>
                        <Ellipse x:Name="TimeBankRing" Stroke="#FF6A00" StrokeThickness="8"
                                 StrokeDashArray="1.8 0.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                          <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90"/>
                          </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock x:Name="TimeBankRingText" Text="0" FontSize="26" FontWeight="Bold"
                                     HorizontalAlignment="Center" Foreground="{StaticResource Accent2}"/>
                          <TextBlock Text="мин" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                      <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="2" Margin="0,18,0,0">
                        <Button x:Name="StartFromBankButton" Content="Играть с банка" Style="{StaticResource AccentButton}"
                                Click="StartFromBank_Click" Margin="0,0,8,0" Padding="14,12"/>
                        <Button Content="Купить новый сеанс" Style="{StaticResource GhostButton}"
                                Click="ShowBuySession_Click" Margin="8,0,0,0" Padding="14,12"/>
                      </UniformGrid>
                    </Grid>
                  </Border>

                  <Border x:Name="HomeBuySessionPanel" Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                    <StackPanel>
                      <TextBlock Text="Купить время с баланса" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                      <TextBlock Text="Тарифы как на кассе · пакеты и почасовые" Foreground="{StaticResource Muted}"
                                 FontSize="12" Margin="0,0,0,12"/>
                      <ComboBox x:Name="TariffCombo" Margin="0,0,0,12" MaxWidth="520" HorizontalAlignment="Left"
                                SelectionChanged="TariffCombo_SelectionChanged"/>
                      <TextBlock x:Name="DurationLabel" Text="Длительность" Foreground="{StaticResource Muted}"
                                 FontSize="12" Margin="0,0,0,8"/>
                      <WrapPanel x:Name="DurationButtonsPanel" Margin="0,0,0,12"/>
                      <TextBlock x:Name="SessionPriceQuote" FontSize="18" FontWeight="Bold"
                                 Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
                      <Button Content="Купить и запустить" Style="{StaticResource AccentButton}"
                              HorizontalAlignment="Left" Padding="20,12" Click="StartSession_Click"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <Border x:Name="HomeSessionBox" Visibility="Collapsed" CornerRadius="20" Margin="0,0,0,20"
                        BorderBrush="#55FF6A00" BorderThickness="1" Padding="22" ClipToBounds="False">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#331A0C08" Offset="0"/>
                      <GradientStop Color="#E61A1A1D" Offset="0.5"/>
                      <GradientStop Color="#221A0C08" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#FF6A00"/>
                  </Border.Effect>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Width="52" Height="52" CornerRadius="16" VerticalAlignment="Center"
                            Background="#332013" Margin="16,0,0,0">
                      <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE735;" FontSize="22"
                                 Foreground="{StaticResource Accent2}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Text="Активный сеанс" Foreground="{StaticResource Accent2}" FontWeight="SemiBold" FontSize="13"/>
                      <TextBlock x:Name="HomeSessionInfo" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                      <TextBlock x:Name="HomeCashDeskHint" Visibility="Collapsed"
                                 Text="Кассовый сеанс · продление и оплата у администратора"
                                 Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                      <WrapPanel x:Name="HomeClientExtendPanel" Margin="0,16,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <DockPanel Margin="0,8,0,10">
                  <Button DockPanel.Dock="Right" Content="Все игры →" Style="{StaticResource GhostButton}"
                          Padding="12,8" FontSize="12" Click="Nav_Click" Tag="games"/>
                  <TextBlock Text="Игры" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel x:Name="HomeGamesPanel" ItemWidth="176" ItemHeight="270" Margin="0,0,0,8"/>
                <TextBlock x:Name="HomeGamesEmpty" Text="Пока нет игр в каталоге."
                           Foreground="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,16"/>

                <DockPanel Margin="0,8,0,10">
                  <Button DockPanel.Dock="Right" Content="В магазин →" Style="{StaticResource GhostButton}"
                          Padding="12,8" FontSize="12" Click="Nav_Click" Tag="shop"/>
                  <TextBlock Text="Из бара" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <WrapPanel x:Name="HomeShopPanel" ItemWidth="176" ItemHeight="250" Margin="0,0,0,8"/>
                <TextBlock x:Name="HomeShopEmpty" Text="Пока нет товаров в баре."
                           Foreground="{StaticResource Muted}" Visibility="Collapsed" Margin="0,0,0,16"/>

                <TextBlock Text="Новости клуба" FontSize="18" FontWeight="Bold" Margin="0,8,0,12"/>
                <StackPanel x:Name="NewsPanel"/>
                <TextBlock x:Name="NewsEmptyHint" Text="Пока нет новостей — следите за обновлениями у администратора."
                           Foreground="{StaticResource Muted}" Visibility="Collapsed" TextWrapping="Wrap"/>

                <TextBlock x:Name="FooterStatus" Foreground="#555" FontSize="11" Margin="0,28,0,8"
                           HorizontalAlignment="Right"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- GAMES -->
          <Border x:Name="TabGames" Background="Transparent" Visibility="Collapsed">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <DockPanel Margin="0,0,0,16">
                  <TextBlock Text="Игры" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Border DockPanel.Dock="Right" Style="{StaticResource SearchShell}" Width="320">
                    <Grid>
                      <DockPanel>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" DockPanel.Dock="Left"
                                 VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Muted}" FontSize="15"/>
                      <TextBox x:Name="SearchBoxGames" BorderThickness="0" Background="Transparent"
                               VerticalContentAlignment="Center" TextChanged="Search_Changed"
                               ToolTip="Поиск игры" CaretBrush="{StaticResource Accent}" Padding="10,10"/>
                    </DockPanel>
                    <TextBlock x:Name="SearchPlaceholderGames" Text="Поиск игр..." IsHitTestVisible="False"
                               Foreground="#666" VerticalAlignment="Center" Margin="40,0,14,0" FontSize="14"/>
                  </Grid>
                </Border>
              </DockPanel>
              <StackPanel Orientation="Horizontal" x:Name="CategoryFilterPanel"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,8" ClipToBounds="False">
              <WrapPanel x:Name="AppsPanel" ItemWidth="210" ItemHeight="330" Margin="0,0,4,4"/>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- SHOP: products left, cart column right -->
        <Border x:Name="TabShop" Background="Transparent" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Бар" FontSize="32" FontWeight="Bold" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" x:Name="ShopCategoryPanel" Margin="0,0,0,10"/>
                <Border x:Name="ShopPayGuestHint" Background="#14241A" CornerRadius="12" Padding="14,10" Margin="0,0,0,8"
                        BorderBrush="#553DDC97" BorderThickness="1" Visibility="Collapsed">
                  <TextBlock Text="Заказ к вашему ПК · оплата при выдаче: наличные или Kaspi QR"
                             Foreground="{StaticResource Success}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel x:Name="ShopPayAccountPanel" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Оплата:" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                  <ComboBox x:Name="ShopPayCombo" Width="200" SelectedIndex="0">
                    <ComboBoxItem Content="Наличные" Tag="CashOnDelivery"/>
                    <ComboBoxItem Content="Kaspi QR" Tag="KaspiQrOnDelivery"/>
                  </ComboBox>
                </StackPanel>
                <Border Style="{StaticResource SearchShell}" Width="280" HorizontalAlignment="Left" Margin="0,4,0,0">
                  <Grid>
                    <DockPanel>
                      <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" DockPanel.Dock="Left"
                                 VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Muted}" FontSize="15"/>
                      <TextBox x:Name="SearchBoxShop" BorderThickness="0" Background="Transparent"
                               VerticalContentAlignment="Center" TextChanged="Search_Changed"
                               ToolTip="Поиск товара" CaretBrush="{StaticResource Accent}" Padding="10,10"/>
                    </DockPanel>
                    <TextBlock x:Name="SearchPlaceholderShop" Text="Поиск товара..." IsHitTestVisible="False"
                               Foreground="#666" VerticalAlignment="Center" Margin="40,0,14,0" FontSize="14"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="ShopFlash" Foreground="{StaticResource Success}" Margin="0,8,0,0"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,12" ClipToBounds="False">
                <WrapPanel x:Name="ShopPanel" ItemWidth="190" ItemHeight="270" Margin="0,0,4,8"/>
              </ScrollViewer>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14">
              <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                  <Border DockPanel.Dock="Right" Background="#33FF6A00" CornerRadius="10" Padding="10,4"
                          VerticalAlignment="Center" x:Name="ShopCartBadgeHost" Visibility="Collapsed">
                    <TextBlock x:Name="ShopCartBadge" Text="0" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource Accent2}"/>
                  </Border>
                  <TextBlock Text="Ваш заказ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                  <TextBlock x:Name="ShopCartSummary" FontWeight="SemiBold" FontSize="14" Text="Корзина пуста"
                             Margin="0,0,0,4" TextWrapping="Wrap"/>
                  <TextBlock x:Name="ShopCartHint" FontSize="11" Foreground="{StaticResource Muted}"
                             Text="Добавьте товары" Margin="0,0,0,12" TextWrapping="Wrap"/>
                  <Button x:Name="CheckoutCartButton" Content="Оформить заказ" Style="{StaticResource AccentButton}"
                          HorizontalAlignment="Stretch" Padding="14,12" Margin="0,0,0,8" Click="CheckoutCart_Click"/>
                  <Button Content="Очистить" Style="{StaticResource GhostButton}"
                          HorizontalAlignment="Stretch" Padding="14,10" Click="ClearCart_Click"/>
                </StackPanel>
                <Border x:Name="ShopCartBar" Visibility="Collapsed" Height="0"/>
                <Border x:Name="ShopCartPanel" Visibility="Visible" Background="Transparent" BorderThickness="0" Padding="0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <StackPanel x:Name="ShopCartEmpty" HorizontalAlignment="Center" Margin="0,32,0,16">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BF;" FontSize="32"
                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="Корзина пуста" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="13"/>
                      </StackPanel>
                      <StackPanel x:Name="ShopCartLines"/>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </DockPanel>
            </Border>
          </Grid>
        </Border>

          <!-- ACCOUNT -->
          <Border x:Name="TabAccount" Background="Transparent" Visibility="Collapsed">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <DockPanel Margin="0,0,0,14">
                  <TextBlock Text="Аккаунт" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button x:Name="AccountRefreshButton" DockPanel.Dock="Right" Content="Обновить"
                          Style="{StaticResource GhostButton}" Padding="14,10" Margin="12,0,0,0"
                          VerticalAlignment="Center" Click="AccountRefresh_Click"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" x:Name="AccountSubNavPanel">
                  <Button x:Name="AccountSubOverview" Content="Профиль" Style="{StaticResource AccentButton}"
                          Padding="14,10" Margin="0,0,8,0" Tag="overview" Click="AccountSubNav_Click"/>
                  <Button x:Name="AccountSubWallet" Content="Кошелёк и банк" Style="{StaticResource GhostButton}"
                          Padding="14,10" Margin="0,0,8,0" Tag="wallet" Click="AccountSubNav_Click"/>
                  <Button x:Name="AccountSubHistory" Content="История" Style="{StaticResource GhostButton}"
                          Padding="14,10" Tag="history" Click="AccountSubNav_Click"/>
                </StackPanel>
                <TextBlock x:Name="AccountLoadError" Foreground="{StaticResource Danger}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>

              <Border x:Name="AccountGuestHint" Style="{StaticResource GlassCard}" Visibility="Collapsed" Padding="28">
                <StackPanel>
                  <TextBlock x:Name="AccountGuestHintTitle" Text="Войдите в аккаунт" FontSize="20" FontWeight="Bold"/>
                  <TextBlock x:Name="AccountGuestHintBody"
                             Text="Профиль, баланс, банк времени, история и смена ПИН — после входа."
                             Foreground="{StaticResource Muted}" Margin="0,10,0,18" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="AccountGuestLoginButton" Content="Войти" Style="{StaticResource AccentButton}"
                            Padding="22,14" HorizontalAlignment="Left" Click="AccountGoLogin_Click"/>
                    <Button x:Name="AccountGuestBindButton" Content="Привязать через Telegram"
                            Style="{StaticResource GhostButton}" Padding="18,14" Margin="12,0,0,0"
                            Visibility="Collapsed" Click="BindAccountTelegram_Click"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <ScrollViewer x:Name="AccountScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,8,8">
                <StackPanel>
                  <!-- Profile -->
                  <StackPanel x:Name="AccountPanelOverview">
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="36" Margin="0,0,20,0">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#FF8A2B" Offset="0"/>
                              <GradientStop Color="#FF6A00" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                          <TextBlock x:Name="AccountAvatarLetter" Text="?" FontSize="28" FontWeight="Bold"
                                     Foreground="#FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="AccountFullName" FontSize="22" FontWeight="Bold"/>
                          <TextBlock x:Name="AccountPhone" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                          <TextBlock x:Name="AccountEmail" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                          <TextBlock x:Name="AccountLoyaltyLevel" Foreground="{StaticResource Accent2}" Margin="0,10,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                      </Grid>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="Лояльность" FontSize="16" FontWeight="Bold"/>
                          <TextBlock x:Name="AccountLoyaltyPct" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="13"/>
                        </DockPanel>
                        <ProgressBar x:Name="AccountLoyaltyBar" Height="10" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,12,0,8" Foreground="#FF6A00"/>
                        <TextBlock x:Name="AccountLoyaltyHint" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,14">
                      <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="16">
                        <StackPanel>
                          <TextBlock Text="Визитов" Foreground="{StaticResource Muted}" FontSize="12"/>
                          <TextBlock x:Name="AccountVisitCount" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource GlassCard}" Margin="0,0,8,0" Padding="16">
                        <StackPanel>
                          <TextBlock Text="Потрачено" Foreground="{StaticResource Muted}" FontSize="12"/>
                          <TextBlock x:Name="AccountTotalSpent" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource GlassCard}" Padding="16">
                        <StackPanel>
                          <TextBlock Text="Банк" Foreground="{StaticResource Muted}" FontSize="12"/>
                          <TextBlock x:Name="AccountBankTotal" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                      </Border>
                    </UniformGrid>

                    <Border x:Name="AccountEngagementCard" Style="{StaticResource GlassCard}" Margin="0,0,0,14"
                            Padding="22" Visibility="Collapsed">
                      <StackPanel>
                        <TextBlock Text="Активность" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock x:Name="AccountVisitStreakText" FontSize="14" Visibility="Collapsed" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AccountPendingBarText" FontSize="14" Margin="0,8,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource Accent2}"/>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <TextBlock Text="Telegram" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="AccountTelegramStatus" Foreground="{StaticResource Muted}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="AccountTelegramLinkButton" Content="Привязать Telegram"
                                  Style="{StaticResource AccentButton}" Padding="18,12"
                                  HorizontalAlignment="Left" Click="AccountTelegramLink_Click"/>
                          <Button x:Name="AccountTelegramChangeButton" Content="Сменить Telegram"
                                  Style="{StaticResource GhostButton}" Padding="18,12" Margin="12,0,0,0"
                                  HorizontalAlignment="Left" Click="AccountTelegramChange_Click"
                                  Visibility="Collapsed"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <TextBlock Text="Комфорт" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ComfortHideBalanceBox" Content="Скрыть баланс" Margin="0,0,0,10"
                                  Foreground="#F4F4F5"/>
                        <CheckBox x:Name="ComfortSoundBox" Content="Звук при запуске игр" Margin="0,0,0,14"
                                  Foreground="#F4F4F5"/>
                        <TextBlock Text="Язык уведомлений" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="Интерфейс Shell пока только на русском"
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                        <ComboBox x:Name="ComfortLanguageCombo" Margin="0,6,0,14" MaxWidth="280" HorizontalAlignment="Left">
                          <ComboBoxItem Content="Русский" Tag="ru"/>
                          <ComboBoxItem Content="Қазақша" Tag="kk"/>
                          <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock Text="Яркость панели" Foreground="{StaticResource Muted}" FontSize="12"
                                     VerticalAlignment="Center"/>
                          <TextBlock x:Name="ComfortBrightnessValue" DockPanel.Dock="Right"
                                     Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="ComfortBrightnessSlider" Minimum="40" Maximum="100" Value="100"
                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,14"
                                ValueChanged="ComfortBrightnessSlider_ValueChanged"/>
                        <TextBlock x:Name="AccountComfortFlash" Foreground="{StaticResource Success}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="AccountComfortError" Foreground="{StaticResource Danger}" Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>
                        <Button Content="Сохранить настройки" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Padding="18,12" Click="AccountSaveComfort_Click"/>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <TextBlock Text="Данные профиля" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Имя" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBox x:Name="AccountFirstNameBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Фамилия" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBox x:Name="AccountLastNameBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Email" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBox x:Name="AccountEmailBox" Margin="0,6,0,8" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Телефон меняется только на кассе" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"/>
                        <TextBlock x:Name="AccountProfileFlash" Foreground="{StaticResource Success}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="AccountProfileError" Foreground="{StaticResource Danger}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button Content="Сохранить профиль" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Padding="18,12" Click="AccountSaveProfile_Click"/>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <TextBlock Text="Сменить ПИН" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="AccountCredStatus" Foreground="{StaticResource Muted}" FontSize="12"
                                   Margin="0,8,0,16" TextWrapping="Wrap"/>
                        <TextBlock Text="Текущий ПИН или пароль" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <PasswordBox x:Name="AccountCurrentSecretBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Новый ПИН (4–8 цифр)" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <PasswordBox x:Name="AccountNewPinBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Повтор нового ПИН" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <PasswordBox x:Name="AccountNewPinConfirmBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <Button Content="Сохранить ПИН" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Padding="18,12" Margin="0,0,0,8"
                                Click="AccountSavePin_Click"/>
                        <TextBlock x:Name="AccountSecurityFlash" Foreground="{StaticResource Success}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="AccountSecurityError" Foreground="{StaticResource Danger}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <TextBlock Text="Пароль и логин" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Текущий ПИН или пароль" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <PasswordBox x:Name="AccountCurrentSecretBox2" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Новый пароль" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <PasswordBox x:Name="AccountNewPasswordBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Повтор нового пароля" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <PasswordBox x:Name="AccountNewPasswordConfirmBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <TextBlock Text="Логин (для входа без телефона)" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBox x:Name="AccountLoginBox" Margin="0,6,0,12" FontSize="15" Padding="12,10"/>
                        <Button Content="Сохранить пароль / логин" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Left" Padding="18,12" Click="AccountSavePassword_Click"/>
                        <TextBlock x:Name="AccountPasswordFlash" Foreground="{StaticResource Success}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="AccountPasswordError" Foreground="{StaticResource Danger}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <Button Content="Выйти из аккаунта" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Padding="18,12" Click="Logout_Click"/>
                  </StackPanel>

                  <!-- Wallet + bank -->
                  <StackPanel x:Name="AccountPanelWallet" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="22">
                      <StackPanel>
                        <TextBlock Text="Кошелёк" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="AccountBalanceBig" FontSize="36" FontWeight="Bold" Margin="0,12,0,0"
                                   Foreground="{StaticResource Accent2}"/>
                        <TextBlock x:Name="AccountBonusBig" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <TextBlock Text="Как пополнить: подойдите на кассу клуба — наличные или Kaspi. Бонусы начисляются при пополнении по уровню лояльности."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>

                    <TextBlock Text="Банк времени по зонам" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Минуты привязаны к зоне. Запуск — только с ПК этой зоны."
                               Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"/>
                    <StackPanel x:Name="AccountBankList"/>
                    <TextBlock x:Name="AccountBankEmpty" Text="Банк пуст — остаток после сеанса появится здесь (при сохранении минут)."
                               Foreground="{StaticResource Muted}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Последние операции" FontSize="16" FontWeight="Bold" Margin="0,8,0,10"/>
                    <StackPanel x:Name="AccountFinanceList"/>
                    <TextBlock x:Name="AccountFinanceEmpty" Text="Пока нет операций"
                               Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
                    <TextBlock Text="Полная история — во вкладке «История»."
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                  </StackPanel>

                  <!-- History -->
                  <StackPanel x:Name="AccountPanelHistory" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                      <Button x:Name="HistorySubSessions" Content="Сеансы" Style="{StaticResource AccentButton}"
                              Padding="12,8" Margin="0,0,8,0" Tag="sessions" Click="HistorySubNav_Click"/>
                      <Button x:Name="HistorySubMoney" Content="Деньги" Style="{StaticResource GhostButton}"
                              Padding="12,8" Margin="0,0,8,0" Tag="money" Click="HistorySubNav_Click"/>
                      <Button x:Name="HistorySubBank" Content="Банк" Style="{StaticResource GhostButton}"
                              Padding="12,8" Margin="0,0,8,0" Tag="bank" Click="HistorySubNav_Click"/>
                      <Button x:Name="HistorySubOrders" Content="Заказы" Style="{StaticResource GhostButton}"
                              Padding="12,8" Margin="0,0,8,0" Tag="orders" Click="HistorySubNav_Click"/>
                      <Button x:Name="HistorySubBookings" Content="Брони" Style="{StaticResource GhostButton}"
                              Padding="12,8" Tag="bookings" Click="HistorySubNav_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="AccountHistoryList"/>
                    <TextBlock x:Name="AccountHistoryEmpty" Text="Пока пусто"
                               Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
                    <Button x:Name="AccountHistoryMoreButton" Content="Показать ещё" Style="{StaticResource GhostButton}"
                            Margin="0,12,0,0" Padding="16,10" HorizontalAlignment="Left"
                            Click="AccountHistoryMore_Click" Visibility="Collapsed"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <!-- HELP -->
          <Border x:Name="TabHelp" Background="Transparent" Visibility="Collapsed"
                  HorizontalAlignment="Stretch">
            <Border Style="{StaticResource GlassCard}" Padding="36" MaxWidth="720" HorizontalAlignment="Stretch">
              <StackPanel>
                <TextBlock Text="Помощь" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Администратор придёт к вашему месту. Кратко опишите проблему — так быстрее помогут."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,22" FontSize="14"/>
                <Grid>
                  <TextBox x:Name="HelpMessageBox" Height="200" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" ToolTip="Опишите проблему"
                           TextChanged="HelpMessageBox_TextChanged" MaxLength="500" Padding="18,16,18,32"
                           Tag="placeholder"/>
                  <TextBlock x:Name="HelpPlaceholder" Text="Опишите вашу проблему..." FontSize="14"
                             Foreground="#666" Margin="20,18,0,0" IsHitTestVisible="False"/>
                  <TextBlock x:Name="HelpCharCount" Text="0 / 500" FontSize="11" Foreground="{StaticResource Muted}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"
                             IsHitTestVisible="False"/>
                </Grid>
                <Button Style="{StaticResource AccentButton}" Margin="0,24,0,0" HorizontalAlignment="Stretch"
                        Click="CallAdmin_Click" Padding="22,16" Content="Вызвать администратора"/>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </Grid>

      <!-- Right widgets -->
      <DockPanel x:Name="ShellRightPanel" Grid.Column="2">
        <Border DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="20">
          <StackPanel>
            <TextBlock x:Name="BalanceLabel" Text="Сеанс" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="BalanceText" FontSize="28" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="BonusText" FontSize="13" Foreground="{StaticResource Accent2}" Margin="0,6,0,0"/>
            <TextBlock x:Name="TimeBankText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="BalanceHint" Text="Пополнение — только на кассе"
                       FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap"/>
            <Button x:Name="HomeEndSessionButton" Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Stretch" Margin="0,18,0,0" Padding="14,13"
                    Click="EndSession_Click" Visibility="Collapsed"
                    ToolTip="Завершить текущий сеанс на этом ПК"
                    Content="Завершить сеанс"/>
            <Button x:Name="BindAccountButton" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="14,12"
                    Click="BindAccountTelegram_Click" Visibility="Collapsed"
                    BorderBrush="#55FF6A00"
                    ToolTip="Привязать гостевой сеанс к аккаунту через Telegram"
                    Content="Сохранить в аккаунт"/>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="20">
          <StackPanel>
            <TextBlock x:Name="SidebarTimeLabel" Text="Осталось" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <Grid Width="176" Height="176" Margin="0,14,0,0" HorizontalAlignment="Center">
              <Ellipse Stroke="#22FFFFFF" StrokeThickness="10"/>
              <Ellipse x:Name="SidebarTimeRing" Stroke="#FF6A00" StrokeThickness="10"
                       StrokeDashArray="1 100" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.7" Color="#FF6A00"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                  <RotateTransform Angle="-90"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <TextBlock x:Name="SidebarTimeText" Text="—" FontSize="28" FontWeight="Bold"
                         Foreground="{StaticResource Accent2}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ProgressBar x:Name="SidebarTimeBar" Height="1" Minimum="0" Maximum="100" Value="0"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="SidebarTimeHint" Text="Время активного сеанса"
                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- ВОЕНКОМАТ: локальный вкл/выкл приёма экстренного сигнала с кассы -->
        <Border DockPanel.Dock="Top" Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="18">
          <StackPanel>
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="14"
                      Background="#4D1A1A" BorderBrush="#88FF4D4D" BorderThickness="1"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="⚠" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FF6B6B"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ВОЕНКОМАТ" FontSize="15" FontWeight="Bold"
                           Foreground="#FF8A8A"/>
                <TextBlock Text="Экстренное оповещение"
                           FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="Сигнал с кассы поверх игр и со звуком. Можно временно выключить на этом ПК."
                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"
                       TextWrapping="Wrap" LineHeight="18"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="VoenkomatOnButton" Grid.Column="0"
                      Content="ВКЛ" Click="VoenkomatOn_Click"
                      Padding="12,12" FontWeight="Bold" FontSize="14"
                      Style="{StaticResource AccentButton}"/>
              <Button x:Name="VoenkomatOffButton" Grid.Column="2"
                      Content="ВЫКЛ" Click="VoenkomatOff_Click"
                      Padding="12,12" FontWeight="Bold" FontSize="14"
                      Style="{StaticResource GhostButton}"/>
            </Grid>
            <Border x:Name="VoenkomatStatusPill" Margin="0,12,0,0" CornerRadius="12"
                    Background="#1A3DDC97" BorderBrush="#443DDC97" BorderThickness="1" Padding="12,8">
              <TextBlock x:Name="VoenkomatStatusText" Text="Сейчас: включено"
                         FontSize="12" FontWeight="SemiBold" Foreground="#3DDC97"
                         TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>
      </DockPanel>
    </Grid>

    <!-- Hidden single search bridge (code syncs from tab boxes) -->
    <TextBox x:Name="SearchBox" Visibility="Collapsed" TextChanged="Search_Changed"/>

    <!-- Task Manager -->
    <Border x:Name="PanelTaskManager" Visibility="Collapsed" Background="#CC050506" Panel.ZIndex="85">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}"
              Width="780" MaxHeight="620" Padding="22">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="Обновить" Style="{StaticResource GhostButton}" Padding="12,8" Margin="0,0,8,0"
                      Click="TaskManagerRefresh_Click"/>
              <Button Content="Завершить" Style="{StaticResource AccentButton}" Padding="12,8" Margin="0,0,8,0"
                      Click="TaskManagerKill_Click"/>
              <Button Content="Закрыть" Style="{StaticResource GhostButton}" Padding="12,8"
                      Click="TaskManagerClose_Click"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Диспетчер задач" FontSize="22" FontWeight="Bold"/>
              <TextBlock x:Name="TaskManagerHint" Text="Выберите процесс и завершите, если игра зависла"
                         Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="TaskManagerError" DockPanel.Dock="Bottom" Foreground="{StaticResource Danger}"
                     Margin="0,10,0,0" TextWrapping="Wrap"/>
          <ListView x:Name="TaskManagerList" Background="#0B0B0C" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    Foreground="#F4F4F5" FontSize="13">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Имя" Width="180" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="ИД" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                <GridViewColumn Header="Память, МБ" Width="90" DisplayMemberBinding="{Binding MemoryMb}"/>
                <GridViewColumn Header="Окно" Width="340" DisplayMemberBinding="{Binding WindowTitle}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Border>

    <!-- UI LOCK -->
    <Border x:Name="PanelUiLock" Visibility="Collapsed" Background="#CC050506" Panel.ZIndex="80">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Width="400" Padding="40">
        <StackPanel>
          <Border Width="64" Height="64" CornerRadius="32" Background="#402013" HorizontalAlignment="Center">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72E;" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Accent}"/>
          </Border>
          <TextBlock Text="ПК заблокирован" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
          <TextBlock x:Name="UnlockHintText"
                     Text="Введите ПИН или пароль, чтобы разблокировать"
                     Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <PasswordBox x:Name="UnlockPinBox" FontSize="18" PasswordChar="●"/>
          <TextBlock x:Name="UnlockError" Foreground="{StaticResource Danger}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <Button Content="Разблокировать" Style="{StaticResource AccentButton}" Margin="0,14,0,0" Click="UnlockUi_Click"/>
          <Button Content="Вызвать администратора" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="CallAdmin_Click"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- SET LOCK PIN -->
    <Border x:Name="PanelSetLockPin" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="90">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}" Width="400" Padding="32">
        <StackPanel>
          <TextBlock Text="Блокировка экрана" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Задайте ПИН из 4–8 цифр. Без него снять блок сможет только касса."
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <TextBlock Text="ПИН-код" FontSize="12" Foreground="{StaticResource Muted}"/>
          <PasswordBox x:Name="SetLockPinBox" FontSize="18" Margin="0,6,0,10" PasswordChar="●"/>
          <TextBlock Text="Повторите ПИН" FontSize="12" Foreground="{StaticResource Muted}"/>
          <PasswordBox x:Name="SetLockPinConfirmBox" FontSize="18" Margin="0,6,0,0" PasswordChar="●"/>
          <TextBlock x:Name="SetLockPinError" Foreground="{StaticResource Danger}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          <Button Content="Заблокировать" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Click="ConfirmSetLockPin_Click"/>
          <Button Content="Отмена" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="CancelSetLockPin_Click"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- Telegram QR dialog (guest bind / account link) -->
    <Border x:Name="PanelTelegramQr" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="98">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}"
              MinWidth="360" MaxWidth="440" Padding="28">
        <StackPanel>
          <TextBlock x:Name="TelegramQrTitle" Text="Telegram" FontSize="20" FontWeight="Bold"
                     HorizontalAlignment="Center"/>
          <Border x:Name="BindQrFrame" Background="#0A0A0C" CornerRadius="14" Padding="14" Margin="0,18,0,0"
                  BorderBrush="#33FF6A00" BorderThickness="1" HorizontalAlignment="Center"
                  Width="248" Height="248">
            <Grid>
              <Image x:Name="BindQrImage" Width="220" Height="220" HorizontalAlignment="Center"
                     Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
              <Border x:Name="BindQrExpiredOverlay" Visibility="Collapsed" Background="#E00A0A0C" CornerRadius="12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                  <TextBlock Text="Код устарел" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                  <TextBlock Text="Нажмите, чтобы получить новый QR"
                             Foreground="{StaticResource Muted}" FontSize="12"
                             Margin="0,8,0,14" HorizontalAlignment="Center" TextAlignment="Center"/>
                  <Button x:Name="BindQrReloadButton" Content="Обновить QR" Style="{StaticResource AccentButton}"
                          Click="BindQrReload_Click" Padding="18,12" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <TextBlock x:Name="BindQrHint" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{StaticResource Muted}" FontSize="13" Margin="0,14,0,0"/>
          <Button Content="Отменить" Style="{StaticResource GhostButton}"
                  Click="CancelTelegramQr_Click" Margin="0,18,0,0" HorizontalAlignment="Stretch" Padding="16,12"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- Shell dialog -->
    <Border x:Name="PanelShellDialog" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="100">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}"
              MinWidth="340" MaxWidth="460" Padding="28">
        <StackPanel>
          <TextBlock x:Name="ShellDialogTitle" Text="Сообщение" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="ShellDialogMessage" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,20"/>
          <StackPanel x:Name="ShellDialogButtonsRow" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ShellDialogCancel" Content="Нет" Style="{StaticResource GhostButton}"
                    Margin="0,0,10,0" Visibility="Collapsed" Click="ShellDialogCancel_Click"/>
            <Button x:Name="ShellDialogAlt" Content="Без сохранения" Style="{StaticResource GhostButton}"
                    Margin="0,0,10,0" Visibility="Collapsed" Click="ShellDialogAlt_Click"/>
            <Button x:Name="ShellDialogOk" Content="Хорошо" Style="{StaticResource AccentButton}"
                    MinWidth="96" Click="ShellDialogOk_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- extend popup -->
    <Border x:Name="ExtendPopup" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="70">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}"
              MinWidth="340" MaxWidth="520" Padding="28">
        <StackPanel>
          <TextBlock Text="Продлить сеанс" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="Списание с баланса аккаунта" Foreground="{StaticResource Muted}" Margin="0,6,0,16"/>
          <StackPanel x:Name="ExtendPopupButtons"/>
          <Button Content="Отмена" Style="{StaticResource GhostButton}" Click="CloseExtend_Click" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- Launch splash -->
    <Border x:Name="PanelLaunchSplash" Visibility="Collapsed" Background="#E6050506" Panel.ZIndex="110">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DialogShell}"
              MinWidth="360" MaxWidth="480" Padding="36">
        <StackPanel>
          <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Ellipse Stroke="#33FFFFFF" StrokeThickness="4"/>
            <Ellipse x:Name="LaunchSpinnerRing" Stroke="#FF6A00" StrokeThickness="4"
                     StrokeDashArray="2 2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="LaunchSpinnerRotate" Angle="0"/>
              </Ellipse.RenderTransform>
            </Ellipse>
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7FC;" FontSize="22"
                       Foreground="{StaticResource Accent2}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="LaunchSplashTitle" Text="Запуск…" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" TextAlignment="Center"/>
          <TextBlock x:Name="LaunchSplashHint" Text="Подождите, приложение открывается"
                     Foreground="{StaticResource Muted}" FontSize="13"
                     HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
